# ── PocketBase instance ─────────────────────────────────────────────
# Base URL of your PocketBase instance (no trailing slash).
VITE_PB_URL=http://127.0.0.1:8090

# ── Bootstrap only (used by scripts/setup-pocketbase.mjs) ───────────
# Superuser credentials. NEVER exposed to the browser bundle.
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me

# Editor account that gets created inside the `editors` auth collection.
# This is the account the management UI logs in with.
PB_EDITOR_EMAIL=editor@example.com
PB_EDITOR_PASSWORD=change-me-too

# Set to "false" to skip writing the 3 categories / 12 links seed data.
PB_SEED=true

# Collection namespace prefix (shared PocketBase instances).
# Do not change after the first run.
PB_PREFIX=aether_
